# Copy this file to keystore.properties and fill in the values.
# keystore.properties is gitignored — never commit the real file.
#
# After generating your keystore with:
#   keytool -genkey -v -keystore okmusic-release.keystore \
#           -alias okmusic -keyalg RSA -keysize 2048 -validity 10000
#
# Fill in the values below:

storeFile=../okmusic-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=okmusic
keyPassword=YOUR_KEY_PASSWORD
