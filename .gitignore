# Dependencies
node_modules/

# Capacitor generated native assets — regenerated by cap sync; don't commit
android/app/src/main/assets/public/

# iOS Pods — regenerated by pod install
ios/App/Pods/

# Build outputs
android/app/build/
android/.gradle/
android/build/

# Signing — NEVER commit these
android/*.keystore
android/*.jks
android/keystore.properties

# Firebase config — injected as GitHub secret during CI builds
android/app/google-services.json

# Local config
android/local.properties

# macOS
.DS_Store
**/.DS_Store

# Editor
.idea/
*.iml
